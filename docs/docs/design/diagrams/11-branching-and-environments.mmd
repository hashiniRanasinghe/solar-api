%% 11-branching-and-environments.mmd - Branching strategy and release path
%% Basis: BRIEF §7.3, §13 (incremental history, shared repo); PLAN §12.
%% DECIDED (YOU): dev_hashini -> dev -> deployment_dev (deploy branch); deployment_qa is a marker and NOT deployed; main never used;
%% the only deployment tracks deployment_dev and is the submitted URL.
%% PROPOSAL: MR gates, release only at phase end, tags on deployment_dev, freeze rule, default branch dev, local database slsea_local.
flowchart LR
  subgraph WORK["Work"]
    HB["dev_hashini<br/>my working branch<br/>small commits, ai-log.md in the same commit<br/>local database slsea_local"]
  end

  subgraph CENTRAL["Central - GitHub default branch"]
    DV["dev<br/>no direct commits"]
  end

  subgraph DEPLOY["Deploy branch"]
    DP["deployment_dev<br/>no direct commits<br/>tags p1 to p8 and submission"]
  end

  DENV["Render service solar-api-dev<br/>database slsea_dev<br/>deploys on each push to deployment_dev<br/>URL to submit"]

  QAB["deployment_qa<br/>kept as a best-practice marker<br/>NOT deployed, no QA service"]
  NOMAIN["main<br/>never used"]

  HB -- "MR after each build step<br/>merge commit, no squash" --> DV
  DV -. "git pull origin dev<br/>keeps dev_hashini in sync" .-> HB
  DV --> G1{"Phase end?<br/>local tests and exit test pass"}
  G1 -- "no" --> HB
  G1 -- "yes: release MR dev to deployment_dev" --> DP
  DP -- "auto-deploy" --> DENV
  DENV -- "BASE_URL=live npm test" --> G2{"Live smoke ok?"}
  G2 -- "yes" --> TAG["Tag pN on deployment_dev<br/>after the last phase: tag submission and freeze dev and deployment_dev"]
  G2 -- "no" --> FIX["Fix on dev_hashini, release again, tag pNb"]
  FIX --> HB
  DV -. "created earlier, then left alone" .-> QAB

  classDef branch fill:#e8f1fb,stroke:#3b6ea5
  classDef env fill:#e9f7ef,stroke:#2e7d4f
  classDef gate fill:#fff8e1,stroke:#c9a227
  classDef unused fill:#f5f5f5,stroke:#999,stroke-dasharray:4 3,color:#666
  class HB,DV,DP branch
  class DENV env
  class G1,G2 gate
  class QAB,NOMAIN unused
