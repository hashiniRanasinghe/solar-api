%% 10-roles-and-permissions.mmd - Who may do what (authorization matrix as a diagram)
%% Basis: BRIEF §2 (write-read split), §5 (writable resources, jurisdiction-scoped reads); WP §9 (401 vs 403); LEC S7, S8
%% Decisions: my-decisions §9, §10, §13. DECIDED (YOU): OQ-03 writable set and roles, OQ-10 401 vs 403.
%% Risk to explain: brief §2 calls SLSEA users "read-clients"; the admin writes installations, never readings.
flowchart LR
  DEV["Device<br/>X-API-Key"]
  RDR["Reader<br/>JWT scope solar:read<br/>national, province or district"]
  ADM["Admin<br/>JWT scopes solar:read + solar:write<br/>national jurisdiction"]

  W1["POST /installations/{own-id}/readings"]
  R1["GET everything readable:<br/>hierarchy, installations, last-reading,<br/>readings under a parent, summary"]
  W2["POST, PUT, DELETE /installations"]
  LG["POST /login<br/>public"]
  NO["PUT, PATCH, DELETE on readings<br/>POST, PUT, DELETE on hierarchy<br/>-> 405 with Allow"]

  DEV -- "own installation only" --> W1
  RDR -- "inside jurisdiction only" --> R1
  ADM -- "all" --> R1
  ADM --> W2
  RDR --> LG
  ADM --> LG

  DEV -. "another installation: 403<br/>no or unknown key: 401" .-> W1
  DEV -. "JWT routes: 401" .-> R1
  RDR -. "outside jurisdiction: 403" .-> R1
  RDR -. "403" .-> W2
  ADM -. "reading POST: 401<br/>needs a device key" .-> W1
  RDR -.-> NO
  ADM -.-> NO

  classDef actor fill:#e8f1fb,stroke:#3b6ea5
  classDef op fill:#e9f7ef,stroke:#2e7d4f
  classDef deny fill:#fdecea,stroke:#c0392b,stroke-dasharray:4 3
  class DEV,RDR,ADM actor
  class W1,R1,W2,LG op
  class NO deny
