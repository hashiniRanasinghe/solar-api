flowchart LR
  S1["Understand<br/>brief, white paper, lectures, reference repos"]
  S2["Plan and design<br/>decisions, 13 diagrams"]
  S3["Repo and database<br/>git setup, Atlas, collaborator<br/>YOU ARE HERE"]
  S4["Phases 1-2, 21-23 Sep<br/>deploy Dev, seed, hierarchy"]
  S5["Phases 3-5, 24-27 Sep<br/>readings, device write, auth"]
  S6["Phases 6-7, 28-29 Sep<br/>queries, admin, Swagger"]
  S7["Phase 8, 30 Sep<br/>tests, audit, tag submission, freeze"]
  S8["Report, to 2 Oct<br/>written by you, in parallel from Phase 4"]
  S9["Submit to LMS, 3-4 Oct<br/>live URL, repo, report, declaration<br/>then the viva, date TBD"]

  S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8 --> S9

  classDef done fill:#e1f5ee,stroke:#0f6e56,color:#085041
  classDef now fill:#faeeda,stroke:#854f0b,color:#633806,stroke-width:3px
