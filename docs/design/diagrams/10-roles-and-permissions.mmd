%% 10-roles-and-permissions.mmd - Who may do what (authorization matrix as a diagram)
%% Basis: BRIEF §2 (write-read split), §5 (writable resources, jurisdiction-scoped reads); WP §9 (401 vs 403); LEC S7, S8
%% Decisions: my-decisions §9, §10, §13. DECIDED: OQ-03 writable set and roles, OQ-10 401 vs 403, device JWT and scopes, 405 on every read-only URI.
%% Risk to explain: brief §2 calls SLSEA users "read-clients"; the admin writes installations, never readings.
flowchart LR
  DEV["Device<br/>JWT scope readings:write<br/>sub = installation id"]
  RDR["Reader<br/>JWT scope solar:read<br/>national, province or district"]
  ADM["Admin<br/>JWT scopes solar:read + installations:write<br/>seeded admin: national"]

  W1["POST /installations/{own-id}/readings"]
  R1["GET everything readable:<br/>hierarchy, installations, last-reading,<br/>readings under a parent, summary"]
  W2["POST /installations (201 + device_key once)<br/>PUT, DELETE /installations/{id}"]
  LG["POST /login<br/>public"]
  NO["PUT, PATCH, DELETE on readings<br/>POST, PUT, PATCH, DELETE on hierarchy,<br/>last-reading, generation-summary<br/>-> 405 with Allow (before 401)"]

  DEV -- "own installation only" --> W1
  RDR -- "inside jurisdiction only" --> R1
  ADM -- "all" --> R1
  ADM -- "installations:write, inside its jurisdiction" --> W2
  DEV --> LG
  RDR --> LG
  ADM --> LG

  DEV -. "another installation: 403<br/>no, invalid or expired token: 401" .-> W1
  DEV -. "any GET: 403 insufficient_scope" .-> R1
  RDR -. "outside jurisdiction: 403" .-> R1
  RDR -. "403 insufficient_scope" .-> W2
  DEV -. "403 insufficient_scope" .-> W2
  ADM -. "missing id: 404; outside subtree (scoped admin): 403<br/>stale If-Match: 412<br/>duplicate meter_id or has readings: 409" .-> W2
  RDR -. "reading POST: 403 insufficient_scope" .-> W1
  ADM -. "reading POST: 403 insufficient_scope" .-> W1
  RDR -.-> NO
  ADM -.-> NO
  DEV -.-> NO

  classDef actor fill:#e8f1fb,stroke:#3b6ea5
  classDef op fill:#e9f7ef,stroke:#2e7d4f
  classDef deny fill:#fdecea,stroke:#c0392b,stroke-dasharray:4 3
  class DEV,RDR,ADM actor
  class W1,R1,W2,LG op
  class NO deny
