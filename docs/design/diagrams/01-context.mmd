%% 01-context.mmd - System context
%% Basis: BRIEF §2 (write-read split), §7 (public HTTPS deploy, live Swagger), §1 (dashboards out of scope)
%% Decisions: my-decisions §1, §6, §9, §10, §13 (one national admin role, OQ-03).
flowchart LR
  DEV["Metering device<br/>one per installation<br/>WRITE client"]
  USR["SLSEA user<br/>national / provincial / district<br/>READ client"]
  ADM["Admin user (seeded admin: national)<br/>installation create / replace / delete"]
  MKR["Marker / lecturer<br/>reads /docs and the Git repo"]
  BI["Downstream dashboards / BI<br/>OUT OF SCOPE (BRIEF §1)"]

  subgraph HOST["Azure App Service web app - HTTPS"]
    API["SLSEA Solar Generation API<br/>Node / Express<br/>base path /solar/v1.0"]
    DOCS["Swagger UI<br/>/docs and /docs.json"]
  end

  DB[("MongoDB Atlas<br/>provinces, districts, substations,<br/>installations, generation_readings, users")]

  DEV -- "POST /login (device key), then POST readings<br/>Bearer JWT, scope readings:write" --> API
  USR -- "POST /login, then GET<br/>Bearer JWT, scope solar:read" --> API
  ADM -- "POST /login, then POST / PUT / DELETE installations<br/>Bearer JWT, scope installations:write" --> API
  API --> DB
  MKR --> DOCS
  BI -. "would consume the read path<br/>(not built)" .-> API

  classDef out fill:#f5f5f5,stroke:#999,stroke-dasharray:4 3,color:#555
  class BI out
