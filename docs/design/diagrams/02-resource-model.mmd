%% 02-resource-model.mmd - REST resources and relationships (Level 2)
%% Basis: BRIEF §3, §5, §6; WP §4.1-4.6 (resource kinds), §5.1, §5.6, §5.7 (naming, scoping, query string); LEC S3, S5, S6, S8
%% Decisions: my-decisions §5, §6, §11. All paths are under the base path /solar/v1.0.
%% DECIDED (YOU): OQ-04 (readings scoped under installation, substation, district, province), OQ-05 (top-level hierarchy),
%% OQ-21 (noun sub-resources). No OPEN dependency remains in this diagram.
flowchart TD
  subgraph HIER["Hierarchy - read-only, top-level (OQ-05)"]
    PROV["/provinces<br/>/provinces/{province-id}<br/>collection + atomic<br/>query: none"]
    DIST["/districts<br/>/districts/{district-id}<br/>query: province_id"]
    SUBS["/substations<br/>/substations/{substation-id}<br/>query: district_id, province_id"]
  end

  INST["/installations<br/>collection (catalogue + creation)<br/>query: province_id, district_id, substation_id"]
  INSTM["/installations/{installation-id}<br/>COMPOSITE: installation + last_reading"]
  RD["/installations/{installation-id}/readings<br/>SCOPED COLLECTION - GET, POST"]
  RDM["/installations/{installation-id}/readings/{reading-id}<br/>atomic - target of Location"]
  LAST["/installations/{installation-id}/last-reading<br/>noun sub-resource, derived (OQ-21)"]

  SUBR["/substations/{substation-id}/readings<br/>SCOPED COLLECTION - GET only"]
  DISTR["/districts/{district-id}/readings<br/>SCOPED COLLECTION - GET only"]
  PROVR["/provinces/{province-id}/readings<br/>SCOPED COLLECTION - GET only"]

  SUM["/districts/{district-id}/generation-summary<br/>noun sub-resource, derived (stretch)"]
  LOGIN["POST /login<br/>PROCESSING FUNCTION (issues JWT)"]

  QRY["Every readings collection takes the same query:<br/>from, to, sort=(timestamp DESC), offset, limit<br/>Path = which parent. Query = how to read it (OQ-04)"]

  PROV -. "1 to many (data relation)" .-> DIST
  DIST -. "1 to many" .-> SUBS
  SUBS -. "1 to many" .-> INST
  INST -- "member" --> INSTM
  INSTM -- "URI scope" --> RD
  RD -- "member" --> RDM
  INSTM -- "URI scope" --> LAST
  SUBS -- "URI scope" --> SUBR
  DIST -- "URI scope" --> DISTR
  PROV -- "URI scope" --> PROVR
  DIST -- "URI scope (stretch)" --> SUM
  QRY -.-> RD
  QRY -.-> SUBR
  QRY -.-> DISTR
  QRY -.-> PROVR

  NOGLOBAL["NOT BUILT: global /readings (phantom collection),<br/>/devices, PATCH, hierarchy writes"]

  classDef coll fill:#e8f1fb,stroke:#3b6ea5
  classDef comp fill:#e9f7ef,stroke:#2e7d4f
  classDef proc fill:#fdf0e3,stroke:#b8681a
  classDef note fill:#f5f5f5,stroke:#999,stroke-dasharray:4 3,color:#444
  class PROV,DIST,SUBS,INST,RD,SUBR,DISTR,PROVR coll
  class INSTM,RDM comp
  class LAST,SUM,LOGIN proc
  class QRY,NOGLOBAL note
