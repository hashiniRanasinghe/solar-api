%% 03-er-model.mmd - Database / ER model (MongoDB collections shown as entities)
%% Basis: BRIEF §3 (entities, no Device, append-only readings, cumulative energy), §4 (seed); LEC S1
%% Decisions: my-decisions §2, §3, §4; docs/design/data-model.md. Matches src/models/.
%% Derived ids are stored read-only and checked by the seed integrity check.
%% Readings carry NO province/district/substation ids: jurisdiction readings resolve installation ids from the path parent (OQ-04).
%% There is deliberately NO Device entity: meter_id is an installation attribute.
erDiagram
  PROVINCE ||--o{ DISTRICT : "has"
  DISTRICT ||--o{ SUBSTATION : "has"
  SUBSTATION ||--o{ INSTALLATION : "has"
  INSTALLATION ||--o{ GENERATION_READING : "append-only history"
  USER }o..o| PROVINCE : "scoped to (level = province)"
  USER }o..o| DISTRICT : "scoped to (level = district)"

  PROVINCE {
    string province_id PK
    string name
  }
  DISTRICT {
    string district_id PK
    string name
    string province_id FK "source of truth"
  }
  SUBSTATION {
    string substation_id PK
    string name
    string district_id FK "source of truth"
    string province_id FK "derived from district, read-only"
  }
  INSTALLATION {
    string installation_id PK
    string meter_id UK "attribute, not an entity"
    string name
    string substation_id FK "source of truth"
    string district_id FK "derived from substation, read-only"
    string province_id FK "derived from substation, read-only"
    number capacity_kw
    string api_key_hash UK "never returned by the API"
    datetime created_at
    datetime updated_at
  }
  GENERATION_READING {
    string reading_id PK
    string installation_id FK "unique with timestamp"
    datetime timestamp "device event time, UTC"
    number power_kw "instantaneous"
    number energy_kwh "cumulative running total"
    number voltage
    datetime received_at "set by server"
  }
  USER {
    string user_id PK
    string username UK
    string password_hash
    string role "reader or admin"
    string jurisdiction_level "national, province or district"
    string jurisdiction_id "not set when national"
  }
